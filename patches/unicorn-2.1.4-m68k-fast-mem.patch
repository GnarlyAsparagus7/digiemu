+    /*
+     * digikit: a page some memory hook covers takes the slow path (where
+     * load_helper/store_helper run the hooks); the watchpoint check itself
+     * is a no-op in Unicorn, so the access then completes normally.
+     */
+    wp_flags |= uc_mem_hook_page_flags(cpu->uc, paddr_page);
 
     index = tlb_index(env, mmu_idx, vaddr_page);
     te = tlb_entry(env, mmu_idx, vaddr_page);
@@ -1208,9 +1268,22 @@ static void notdirty_write(CPUState *cpu, vaddr mem_vaddr, unsigned size,
     // - have memory hooks installed
     // - or doing snapshot
     // , then never clean the tlb
+    //
+    // digikit: the page is cleaned when it holds no translated code, not
+    // when its TLB entry is non-executable. Unicorn stubs the dirty bitmap
+    // (cpu_physical_memory_is_clean is always true), so every writable page
+    // starts NOTDIRTY; on a CPU whose TLB grants EXEC everywhere (m68k
+    // without an MMU) the old `addr_code == -1` test was never true, and
+    // every guest store stayed on the slow path for good. tlb_protect_code
+    // re-arms NOTDIRTY when code is later translated on the page.
+    //
+    // No "memory hook installed" test either: uc_mem_hook_installed counts
+    // every hook type, so one global UC_HOOK_MEM_INVALID hook (a demand
+    // mapper) made every page "hooked" and kept every store here. A page a
+    // read/write hook covers carries TLB_WATCHPOINT (uc_mem_hook_page_flags),
+    // which tlb_set_dirty leaves alone, so hooked pages stay on the slow path.
     if (!(!mr || (tlbe->addr_write != -1 && mr->priority < cpu->uc->snapshot_level)) &&
-            !(tlbe->addr_code != -1) &&
-            !uc_mem_hook_installed(cpu->uc, tlbe->paddr | (mem_vaddr & ~TARGET_PAGE_MASK))) {
+            !tb_page_has_code(cpu->uc, ram_addr)) {
         tlb_set_dirty(cpu, mem_vaddr);
     }
 }
