 /* update the TLB so that writes in physical page 'phys_addr' are no longer
@@ -800,6 +811,49 @@ static void tlb_add_large_page(CPUArchState *env, int mmu_idx,
     env_tlb(env)->d[mmu_idx].large_page_mask = lp_mask;
 }
 
+/*
+ * digikit: which accesses to a guest page carry Unicorn memory hooks.
+ * -> BP_MEM_READ and/or BP_MEM_WRITE. A hook with begin > end covers the
+ * whole address space, as HOOK_BOUND_CHECK treats it.
+ */
+static bool uc_hook_overlaps(struct hook *hook, hwaddr lo, hwaddr hi)
+{
+    if (hook->begin > hook->end) {
+        return true;
+    }
+    return hook->begin <= hi && hook->end >= lo;
+}
+
+static int uc_mem_hook_page_flags(struct uc_struct *uc, hwaddr page)
+{
+    struct hook *hook;
+    HOOK_FOREACH_VAR_DECLARE;
+    hwaddr last = page + TARGET_PAGE_SIZE - 1;
+    int flags = 0;
+
+    HOOK_FOREACH(uc, hook, UC_HOOK_MEM_READ) {
+        if (!hook->to_delete && uc_hook_overlaps(hook, page, last)) {
+            flags |= BP_MEM_READ;
+            break;
+        }
+    }
+    if (!(flags & BP_MEM_READ)) {
+        HOOK_FOREACH(uc, hook, UC_HOOK_MEM_READ_AFTER) {
+            if (!hook->to_delete && uc_hook_overlaps(hook, page, last)) {
+                flags |= BP_MEM_READ;
+                break;
+            }
+        }
+    }
+    HOOK_FOREACH(uc, hook, UC_HOOK_MEM_WRITE) {
+        if (!hook->to_delete && uc_hook_overlaps(hook, page, last)) {
+            flags |= BP_MEM_WRITE;
+            break;
+        }
+    }
+    return flags;
+}
+
 /* Add a new TLB entry. At most one entry for a given virtual address
  * is permitted. Only a single TARGET_PAGE_SIZE region is mapped, the
  * supplied size is only used by tlb_flush_page.
