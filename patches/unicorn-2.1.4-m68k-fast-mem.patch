+// digikit: memory hooks are routed per page through the TLB, so a change
+// must refill it. Flushing while emulating (from inside a hook) would
+// reallocate the TLB under the access in progress, so that case is deferred
+// to the next top-level uc_emu_start.
+static void uc_mem_hooks_changed(uc_engine *uc)
+{
+    if (uc->nested_level == 0 && uc->tcg_flush_tlb) {
+        uc->tcg_flush_tlb(uc);
+    } else {
+        uc->mem_hooks_changed = true;
+    }
+}
