+/*
+ * digikit: a whole single-accumulator MAC/MSAC -- multiply, accumulate,
+ * saturate, set the flags -- in one call, doing exactly what the separate
+ * helpers and the inline add did, in the same order. Each helper call makes
+ * TCG write back and reload every live global, so three calls per MAC was
+ * most of what a DSP loop cost.
+ *
+ * ctl: bits 1..0 mode (0 fractional, 1 signed, 2 unsigned), bit 2 MSAC,
+ * bits 4..3 the integer scale factor from extension-word bits 10..9.
+ */
+void HELPER(mac_fused)(CPUM68KState *env, uint32_t rx, uint32_t ry,
+                       uint32_t acc, uint32_t ctl)
+{
+    uint32_t mode = ctl & 3;
+    uint64_t product;
+
+    if (mode == 0) {
+        product = dk_macmulf(env, rx, ry);
+    } else {
+        product = mode == 1 ? dk_macmuls(env, rx, ry)
+                            : dk_macmulu(env, rx, ry);
+        switch ((ctl >> 3) & 3) {
+        case 1:
+            product <<= 1;
+            break;
+        case 3:
+            product = mode == 1 ? (uint64_t)((int64_t)product >> 1)
+                                : product >> 1;
+            break;
+        }
+    }
+    if (ctl & 4) {
+        env->macc[acc] -= product;
+    } else {
+        env->macc[acc] += product;
+    }
+    if (mode == 0) {
+        dk_macsatf(env, acc);
+    } else if (mode == 1) {
+        dk_macsats(env, acc);
+    } else {
+        dk_macsatu(env, acc);
+    }
+    dk_mac_set_flags(env, acc);
+}
