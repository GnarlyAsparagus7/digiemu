+// store_helper (cputlb.c). Checks after code and block hooks remain.
+static void check_exit_request_mem(TCGContext *tcg_ctx)
+{
+    if (tcg_ctx->uc->digikit_no_mem_exit) {
+        return;
+    }
+    check_exit_request(tcg_ctx);
