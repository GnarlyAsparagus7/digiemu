 }
+
+/*
+ * digikit speed options (patches/unicorn-2.1.4-m68k-digikit-speed.patch).
+ * Both default off, so an engine nobody configures behaves as stock.
+ *   1: m68k `rte` is done natively instead of through UC_HOOK_INTR.
+ *   2: no exit-request check after each guest load/store; a memory hook that
+ *      calls uc_emu_stop then stops at the end of its block. Translation-time,
+ *      so changing it flushes the translated code.
+ *   4: memory read/write hooks see the PC as last synced (the start of the
+ *      block, typically) instead of an exact PC rebuilt for every access.
+ */
+#define UC_DIGIKIT_NATIVE_RTE 1u
+#define UC_DIGIKIT_NO_MEM_EXIT 2u
+#define UC_DIGIKIT_NO_HOOK_PC_SYNC 4u
+
+UNICORN_EXPORT
+uint32_t uc_digikit_options_supported(void)
+{
+    return UC_DIGIKIT_NATIVE_RTE | UC_DIGIKIT_NO_MEM_EXIT |
+           UC_DIGIKIT_NO_HOOK_PC_SYNC;
+}
+
+UNICORN_EXPORT
+uc_err uc_digikit_set_options(uc_engine *uc, uint32_t options)
+{
+    bool no_mem_exit = (options & UC_DIGIKIT_NO_MEM_EXIT) != 0;
+
+    if (options & ~uc_digikit_options_supported()) {
+        return UC_ERR_ARG;
+    }
+    UC_INIT(uc);
+    uc->digikit_native_rte = (options & UC_DIGIKIT_NATIVE_RTE) != 0;
+    uc->digikit_no_hook_pc_sync = (options & UC_DIGIKIT_NO_HOOK_PC_SYNC) != 0;
+    if (uc->digikit_no_mem_exit != no_mem_exit) {
+        uc->digikit_no_mem_exit = no_mem_exit;
+        uc->tb_flush(uc);
+    }
+    restore_jit_state(uc);
+    return UC_ERR_OK;
+}
